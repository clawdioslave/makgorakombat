{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The room relay for online play: one Durable Object per room code, forwarding each player's
  // messages to the other. It keeps nothing of the game; see README.md.
  "name": "makgora-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
